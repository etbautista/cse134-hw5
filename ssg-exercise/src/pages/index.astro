---
import Footer from "../components/Footer.astro"
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ethanbautista.dev</title>
    <link rel="icon" href="public/assets/icons/signature.svg"/>
    <link rel="stylesheet" href="/css/style.css"/>
    
    <style>
        horizontal-container {
            display: flex;
            flex-direction: row;
        }
        #hobby-3-text {
            border: 1px solid red ;
        }
    </style>
</head>
<body>
    <nav>
        <a href="index.html">
            <svg width="54" height="54" viewBox="0 0 54 54" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="54" height="54" rx="16" fill="#FFFCF2"/>
                <path d="M9.91425 17.6H23.4823V20.096H12.6023V27.52H23.2903V30.016H12.6023V37.504H23.6743V40H9.91425V17.6ZM28.324 37.504H30.244V20.096H28.324V17.6H37.38C38.4467 17.6 39.3853 17.7493 40.196 18.048C41.028 18.3467 41.7213 18.752 42.276 19.264C42.852 19.776 43.2787 20.3947 43.556 21.12C43.8547 21.824 44.004 22.592 44.004 23.424V23.808C44.004 24.4267 43.908 24.992 43.716 25.504C43.524 26.016 43.2573 26.4747 42.916 26.88C42.5747 27.2853 42.1693 27.6373 41.7 27.936C41.252 28.2133 40.7613 28.4267 40.228 28.576V28.96C41.2947 29.2587 42.1907 29.8347 42.916 30.688C43.6413 31.52 44.004 32.544 44.004 33.76V34.144C44.004 34.976 43.8547 35.7547 43.556 36.48C43.2787 37.184 42.852 37.8027 42.276 38.336C41.7213 38.848 41.028 39.2533 40.196 39.552C39.3853 39.8507 38.4467 40 37.38 40H28.324V37.504ZM32.932 37.504H37.188C38.4467 37.504 39.4707 37.1947 40.26 36.576C41.0493 35.936 41.444 35.0613 41.444 33.952V33.76C41.444 32.608 41.0707 31.7013 40.324 31.04C39.5773 30.3573 38.564 30.016 37.284 30.016H32.932V37.504ZM32.932 27.52H37.284C38.564 27.52 39.5773 27.1893 40.324 26.528C41.0707 25.8667 41.444 24.96 41.444 23.808V23.616C41.444 22.528 41.0493 21.6747 40.26 21.056C39.4707 20.416 38.4467 20.096 37.188 20.096H32.932V27.52Z" fill="#EB5E28"/>
            </svg>
        </a>
        <horizontal-container>
            <button id="theme-change">Change Theme</button>
            <button id="facts-toggle">Toggle Facts</button>
            <noscript>
                <small>Enable JavaScript to load fact widget.</small>
            </noscript>
            <a href="about-me.html">{"{aboutMe}"}</a>
            <a href="projects-page.html">{"{projects}"}</a>
            <a href="/public/assets/EthanGBautista-Resume.pdf" download="EthanGBautista-Resume">{"{resume}"}</a>
            <a href="#contact">{"{contact}"}</a> 
        </horizontal-container>
    </nav>

    <dialog id="progress-bar-modal">
        <label for="progress-bar">File Progress:</label>
        <progress id="progress-bar" value="0" max="100"></progress>
    </dialog>

    <header>
        <horizontal-container>
            <div class="hero-text">
                <p>Hello! I'm Ethan, a</p>
                <h1>Frontend Developer & UI/UX Designer</h1>
                <hr>
                <p>I'm Currently at...</p>
                <p>UC San Diego Pursuing <br> B.S. Cognitive Science w/ Spec. Design & Interaction</p>
            </div>
            <picture>
                <img src="public/assets/images/placeholder.png" alt="placeholder image"/>
            </picture>
        </horizontal-container>
    </header>

    <main>
        <section id="technologies">
            <h2>My Toolbox</h2>
            <p class="cosmetic-text">const techStach = {}</p>
            <horizontal-container>
                <button id="left-arrow">
                    <img src="public/assets/icons/left.svg" alt="Slide Left">
                </button>
                <horizontal-container  id="tech-slider">
                    <horizontal-container class="tech-page">
                        <div class="tech-container">
                            <hr>
                                <img src="public/assets/icons/figma.svg" alt="The Figma Logo">
                                <p>Figma</p>
                            <hr>
                        </div>
                        <div class="tech-container">
                            <hr>
                                <img src="public/assets/icons/HTML5.svg" alt="The HTML Logo">
                                <p>HTML</p>
                            <hr>
                        </div>
                        <div class="tech-container">
                            <hr>
                                <img src="public/assets/icons/css-new.svg" alt="The CSS Logo">
                                <p>CSS</p>
                            <hr>
                        </div>
                        <div class="tech-container">
                            <hr>
                                <img src="public/assets/icons/javascript.svg" alt="The JavaScript Logo">
                                <p>JavaScript</p>
                            <hr>
                        </div>
                        <div class="tech-container">
                            <hr>
                                <img src="public/assets/icons/typescript.svg" alt="The TypeScript Logo">
                                <p>TypeScript</p>
                            <hr>
                        </div>
                    </horizontal-container>

                    <horizontal-container class="tech-page">
                        <div class="tech-container">
                            <hr>
                                <img src="public/assets/icons/React.svg" alt="The ReactJs Logo">
                                <p>ReactJs</p>
                            <hr>
                        </div>
                        <div class="tech-container">
                            <hr>
                                <img src="public/assets/icons/firebase.svg" width="" alt="The Firebase Logo">
                                <p>Firebase</p>
                            <hr>
                        </div>
                        <div class="tech-container">
                            <hr>
                                <img src="public/assets/icons/nextdotjs.svg" alt="The NextJs Logo">
                                <p>Next.Js</p>
                            <hr>
                        </div>
                        <div class="tech-container">
                            <hr>
                                <img src="public/assets/icons/Tailwind_CSS.svg" alt="The Tailwind CSS Logo">
                                <p>Tailwind</p>
                            <hr>
                        </div>
                        <div class="tech-container">
                            <hr>
                                <img src="public/assets/icons/java.svg" alt="The Java Logo">
                                <p>Java</p>
                            <hr>
                        </div>
                    </horizontal-container>

                    <horizontal-container class="tech-page">
                        <div class="tech-container">
                            <hr>
                                <img src="public/assets/icons/c.svg" alt="The C Logo">
                                <p>C</p>
                            <hr>
                        </div>
                        <div class="tech-container">
                            <hr>
                                <img src="public/assets/icons/c-plusplus.svg" alt="The C++ Logo">
                                <p>C++</p>
                            <hr>
                        </div>
                        <div class="tech-container">
                            <hr>
                                <img src="public/assets/icons/python.svg" alt="The Python Logo">
                                <p>Python</p>
                            <hr>
                        </div>
                        <div class="tech-container">
                            <hr>
                                <img src="public/assets/icons/React.svg" alt="The ReactNative Logo">
                                <p>ReactNative</p>
                            <hr>
                        </div>
                        <div class="tech-container">
                            <hr>
                                <img src="public/assets/icons/git.svg" alt="The Git Logo">
                                <p>Git</p>
                            <hr>
                        </div>
                    </horizontal-container>
                    
                </horizontal-container>
                <button id="right-arrow">
                    <img src="public/assets/icons/right.svg" alt="Slide Right ">
                </button>
            </horizontal-container>
        </section>

        <section id="recent-projects">
            <p class="cosmetic-text">&lt;projects&gt;</p>
            <h2>
                Here's What I've Been up to Recently...
            </h2>

            <project-container>
                 <a href="project-page-template.html">
                    <horizontal-container>
                        <img src="/public/assets/images/landscape-placeholder.png" alt="project 1 thumbnail">
                        <div>
                            <h3>Project Name - Role</h3>
                            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc molestie magna quis leo fringilla, id eleifend massa porta. Praesent eu lacinia leo, vitae laoreet urna. Cras sit amet sodales odio, sit amet ornare nunc.</p>
                            <horizontal-container>
                                <project-tag data-status="designer">
                                    <p>Designer</p>
                                </project-tag>
                                <project-tag data-status="css">
                                    <p>CSS</p>
                                </project-tag>
                                <project-tag data-status="reactjs">
                                    <p>ReactJs</p>
                                </project-tag>
                                <project-tag data-status="developer">
                                    <p>Developer</p>
                                </project-tag>
                            </horizontal-container>
                        </div>

                    </horizontal-container>
                 </a>
            </project-container>

            <project-container>
                 <a href="project-page-template.html">
                    <horizontal-container>
                        <img src="/public/assets/images/landscape-placeholder.png" alt="project 2 thumbnail">
                        <div>
                            <h3>Project Name - Role</h3>
                            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc molestie magna quis leo fringilla, id eleifend massa porta. Praesent eu lacinia leo, vitae laoreet urna. Cras sit amet sodales odio, sit amet ornare nunc.</p>
                            <horizontal-container>
                                <project-tag data-status="designer">
                                    <p>Designer</p>
                                </project-tag>
                                <project-tag data-status="css">
                                    <p>CSS</p>
                                </project-tag>
                                <project-tag data-status="reactjs">
                                    <p>ReactJs</p>
                                </project-tag>
                                <project-tag data-status="developer">
                                    <p>Developer</p>
                                </project-tag>
                            </horizontal-container>
                        </div>

                    </horizontal-container>
                 </a>
            </project-container>

            <project-container>
                 <a href="project-page-template.html">
                    <horizontal-container>
                        <img src="/public/assets/images/landscape-placeholder.png" alt="project 3 thumbnail">
                        <div>
                            <h3>Project Name - Role</h3>
                            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc molestie magna quis leo fringilla, id eleifend massa porta. Praesent eu lacinia leo, vitae laoreet urna. Cras sit amet sodales odio, sit amet ornare nunc.</p>
                            <horizontal-container>
                                <project-tag data-status="designer">
                                    <p>Designer</p>
                                </project-tag>
                                <project-tag data-status="css">
                                    <p>CSS</p>
                                </project-tag>
                                <project-tag data-status="reactjs">
                                    <p>ReactJs</p>
                                </project-tag>
                                <project-tag data-status="developer">
                                    <p>Developer</p>
                                </project-tag>
                            </horizontal-container>
                        </div>

                    </horizontal-container>
                 </a>
            </project-container>



            <a href="projects-page.html">{"{View All Here}"}</a>
            <p class="cosmetic-text">&lt;/projects&gt;</p>
        </section>

        <section id="about-me">
            <p class="cosmetic-text">&lt;aboutMe&gt;</p>
            <indent>
                <h2>In my free time I'm a...</h2>
                    <horizontal-container>
                        <div>
                            <h3><strong>Hobby 1</strong>, <em>Hobby 2</em>, and a <span id="hobby-3-text">Hobby 3</span></h3>
                            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc molestie magna quis leo fringilla, id eleifend massa porta. Praesent eu lacinia leo, vitae laoreet urna. Cras sit amet sodales odio, sit amet ornare nunc. Nunc eu eleifend ipsum. Maecenas at cursus enim.Praesent eu lacinia leo, vitae laoreet urna. Cras sit amet sodales odio, sit amet ornare nunc. Nunc eu eleifend ipsum. Maecenas at cursus enim.</p>
                        </div>
    
                        <animated-sliding-carousel>
                            <img src="public/assets/images/placeholder.png" alt="picture of hobby 1"/>
                            <img src="public/assets/images/placeholder.png" alt="picture of hobby 2"/>
                            <img src="public/assets/images/placeholder.png" alt="picture of hobby 3"/>
                        </animated-sliding-carousel>
                    </horizontal-container>
                <p class="cosmetic-text">&lt;/aboutMe&gt;</p>
            </indent>
        </section>
    </main>

    <Footer />

    <hello-log></hello-log>

    <script>
        class HelloLog extends HTMLElement {
            constructor() {
                super();
                console.log("Hello World!");
            }
        }

        customElements.define("hello-log", HelloLog);
    </script>

    <script type="module" src="theme-change.js" defer ></script>
    <script type="module" src="slider.js" defer ></script>
    <script type="module" src="web-component.js" defer ></script>
</body>
</html>